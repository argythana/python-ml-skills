#!/usr/bin/env python3
"""List existing tag names in the my_notes vault, alphabetically (case-insensitive sort)."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

DEFAULT_TAGS_DIR = Path("/home/tharg/Documents/my_notes/tags")


def list_tags(tags_dir: Path) -> list[str]:
    if not tags_dir.is_dir():
        raise FileNotFoundError(f"Tags directory does not exist: {tags_dir}")
    return [path.stem for path in sorted(tags_dir.glob("*.md"), key=lambda p: p.name.casefold())]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tags-dir", type=Path, default=DEFAULT_TAGS_DIR)
    parser.add_argument("--format", choices=("text", "json"), default="text")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    tags = list_tags(args.tags_dir.expanduser())
    if args.format == "json":
        print(json.dumps(tags, ensure_ascii=True, indent=2))
        return 0
    for tag in tags:
        print(tag)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
