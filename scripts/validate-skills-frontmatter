#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "pathname"
require "yaml"

MAX_DESCRIPTION_LENGTH = 1024

USAGE = <<~TEXT
  Usage: scripts/validate-skills-frontmatter [--staged] [PATH...]

  Validate SKILL.md frontmatter in the working tree or staged index.
  With no paths, validates every repo skill in the selected source.
TEXT

def usage!
  puts USAGE
  exit 0
end

def staged_skill_paths(repo_root)
  stdout, status = Open3.capture2(
    "git",
    "-C",
    repo_root.to_s,
    "diff",
    "--cached",
    "--name-only",
    "--diff-filter=ACMR",
    "-z",
    "--"
  )
  abort "failed to read staged file list" unless status.success?

  stdout.split("\0").select { |path| path.end_with?("/SKILL.md") }.sort
end

def read_skill_source(repo_root, path, staged:)
  if staged
    stdout, stderr, status = Open3.capture3(
      "git",
      "-C",
      repo_root.to_s,
      "show",
      ":#{path}"
    )
    return [stdout, nil] if status.success?

    message = stderr.strip
    message = "git show failed for staged file" if message.empty?
    return [nil, message]
  end

  absolute_path = repo_root / path
  return [absolute_path.read, nil]
rescue Errno::ENOENT => e
  [nil, e.message]
end

def validate_frontmatter(path, raw)
  match = raw.match(/\A---\n(.*?)\n---(?:\n|\z)/m)
  return ["missing frontmatter block at top of file"] unless match

  frontmatter_raw = match[1]
  errors = []

  begin
    frontmatter = YAML.safe_load(frontmatter_raw, permitted_classes: [], aliases: false)
  rescue Psych::SyntaxError => e
    return ["YAML parse error: #{e.message.lines.first&.strip || e.message}"]
  end

  unless frontmatter.is_a?(Hash)
    return ["frontmatter must be a YAML mapping"]
  end

  unless frontmatter.keys == ["name", "description"]
    errors << "frontmatter keys must be exactly ['name', 'description'] in that order"
  end

  name = frontmatter["name"]
  description = frontmatter["description"]
  directory = File.basename(File.dirname(path))

  unless name.is_a?(String) && !name.strip.empty?
    errors << "name must be a non-empty string"
  end

  unless description.is_a?(String) && !description.strip.empty?
    errors << "description must be a non-empty string"
  end

  if description.is_a?(String)
    description_length = description.strip.length
    if description_length >= MAX_DESCRIPTION_LENGTH
      errors << "description must be less than #{MAX_DESCRIPTION_LENGTH} characters (currently #{description_length})"
    end
  end

  if name.is_a?(String) && name != directory
    errors << "name must match directory '#{directory}'"
  end

  unless frontmatter_raw.match?(/^description:\s*>\s*$/)
    errors << "description must use folded scalar style `description: >`"
  end

  errors
end

repo_root = Pathname(__dir__).dirname
staged = false
paths = []

ARGV.each do |arg|
  case arg
  when "--staged"
    staged = true
  when "-h", "--help"
    usage!
  else
    paths << arg
  end
end

paths = if paths.empty?
  staged ? staged_skill_paths(repo_root) : Dir.chdir(repo_root) { Dir.glob("*/SKILL.md").sort }
else
  paths.sort
end

if paths.empty?
  puts "No skill files to validate."
  exit 0
end

failures = []

paths.each do |path|
  content, read_error = read_skill_source(repo_root, path, staged: staged)
  if read_error
    failures << [path, ["could not read file: #{read_error}"]]
    next
  end

  errors = validate_frontmatter(path, content)
  failures << [path, errors] unless errors.empty?
end

if failures.empty?
  source_label = staged ? "staged" : "working tree"
  puts "Validated #{paths.length} skill frontmatter file(s) from #{source_label}."
  exit 0
end

failures.each do |path, errors|
  warn "#{path}:"
  errors.each do |error|
    warn "  - #{error}"
  end
end

exit 1
